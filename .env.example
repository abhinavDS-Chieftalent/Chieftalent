# ---- NVIDIA NIM (OpenAI-compatible) ----
# Recommended: run a dedicated nim-proxy container for this app:
#   docker run -d --name hr-nim-proxy -p 127.0.0.1:8100:8000 \
#     -v hr-nim-proxy-data:/data --restart unless-stopped \
#     ghcr.io/miztertea/nim-proxy:latest
# then complete its setup wizard at http://localhost:8100/setup (paste your
# NVIDIA build.nvidia.com key(s) there - never in this file). In keyed mode,
# put the minted npk_... client key in NIM_API_KEY; in open mode leave it empty.
NIM_BASE_URL=http://localhost:8100/v1
NIM_API_KEY=
# Pinned efficient model (verified). Fallbacks: z-ai/glm-5.3-flash, moonshotai/kimi-k3
# Leave empty to auto-discover from /v1/models.
NIM_MODEL=openai/gpt-oss-20b

# ---- ATS ----
ATS_THRESHOLD=70

# ---- SMTP (leave SMTP_HOST empty to use the dev outbox at data/outbox/) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---- App ----
# The web app itself. NOTE: port 8000 is the NIM proxy (AI backend), so the
# app must NOT use 8000. Default 5000; set PORT to change it.
HOST=127.0.0.1
PORT=5000
BASE_URL=http://localhost:5000
SECRET_KEY=change-me-in-production
# If set, /admin requires ?key=<ADMIN_KEY> or X-Admin-Key header. Empty = open (local dev only).
ADMIN_KEY=

# ---- Interview timing ----
# Server-side grace period (seconds) added to each question's time limit to allow upload latency.
HR_TIME_GRACE_SECONDS=15

# ---- Final score blend ----
OBJECTIVE_WEIGHT=0.4
SPOKEN_WEIGHT=0.6
PASS_THRESHOLD=70
BORDERLINE_THRESHOLD=50
