%% ============================================================
%% 2. HR PIPELINE (JD -> CV -> ATS -> shortlist -> review)
%% ============================================================
flowchart LR

    A1["HR creates JD<br/>paste text or upload PDF"] --> A2["jd_parser structures JD<br/>(LLM, fallback deterministic)"]
    A2 --> A3["Job saved<br/>jobs table + job_postings JSON + PDF"]
    A3 --> A4["CVs dropped in<br/>jobs/role/ folder"]
    A4 --> A5["pipeline.py picks up<br/>unprocessed CVs"]
    A5 --> A6["cv_parser<br/>PDF to text"]
    A6 --> A7["ats_reviewer<br/>LLM scores vs JD<br/>temp 0, hash-cached"]
    A7 --> A8{"score >= 70<br/>(ATS_THRESHOLD)?"}
    A8 -- "no" --> A9["Rejected<br/>workflow stops"]
    A8 -- "yes" --> A10["Shortlisted"]
    A10 --> A11["create_interview<br/>token, questions deferred"]
    A11 --> A12["Email invite<br/>with interview link"]
    A12 --> A13["Candidate completes<br/>interview + evaluation"]
    A13 --> A14["HR reviews<br/>Dashboard / CandidateDetail"]
    A14 --> A15{"HR decision"}
    A15 --> A16["Progress / Shortlist"]
    A15 --> A17["Reject"]
    A15 --> A18["Retake<br/>new interview"]
    A15 --> A19["Re-evaluate<br/>re-run AI scoring"]

%% ============================================================
%% 3. CANDIDATE INTERVIEW JOURNEY
%% ============================================================
sequenceDiagram
    actor C as Candidate
    participant SPA as Interview SPA
    participant API as Flask API
    participant ISVC as interview_service
    participant QGEN as question_generator
    participant ESVC as evaluation_service
    participant LLM as NIM LLM

    C->>SPA: Opens /interview/token from email
    SPA->>API: GET /state
    API->>ISVC: validate token
    ISVC-->>SPA: phase: verify

    SPA->>API: POST /verify/request
    API->>ISVC: generate OTP
    ISVC-->>C: OTP email (SMTP)
    C->>SPA: Enters OTP
    SPA->>API: POST /verify/confirm
    API->>ISVC: verify OTP
    ISVC-->>SPA: phase: details

    C->>SPA: Fills details form
    SPA->>API: POST /details
    API->>ISVC: save candidate_details
    ISVC->>QGEN: kick question generation (if not ready)
    QGEN->>LLM: 1 spoken intro + 20 MCQs<br/>10 JD-based + 10 resume-based
    LLM-->>QGEN: question set (JSON)
    ISVC-->>SPA: phase: guidelines

    C->>SPA: Accepts guidelines
    SPA->>API: POST /guidelines
    ISVC-->>SPA: phase: interview

    Note over SPA,C: Proctoring active:<br/>fullscreen lock, tab-switch<br/>3rd warning aborts

    C->>SPA: Speaks intro (5 min target)
    SPA->>API: POST /answer (audio + video + transcript)
    API->>ISVC: save answer
    loop 20 MCQs
        C->>SPA: Selects option
        SPA->>API: POST /answer
        API->>ISVC: save + score deterministically
    end

    SPA->>API: POST /answer (final)
    API->>ESVC: evaluate_interview (async thread)
    ESVC->>LLM: score spoken answers
    LLM-->>ESVC: scores + strengths/weaknesses
    ESVC-->>API: blended score (0.4/0.6) + recommendation
    API-->>SPA: phase: completed
    SPA-->>C: /interview/token/done
