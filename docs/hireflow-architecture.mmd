%% AI-powered HR screening platform. Verified against source: app/, frontend/src/
%% Stack: Flask + React SPA (Vite) + SQLite + NVIDIA NIM LLM + SMTP, Dockerized.

%% ============================================================
%% 1. SYSTEM ARCHITECTURE
%% ============================================================
flowchart TB

    subgraph ACTORS["Actors"]
        HR["HR / Admin<br/>(yash@dotstark.com)"]
        REC["Recruiter"]
        CAND["Candidate"]
    end

    subgraph SPA["React SPA (Vite, react-router)"]
        LAND["/ Landing"]
        LOGIN["/login"]
        DASH["/admin Dashboard<br/>candidates + jobs + AI status"]
        CDET["/admin/candidate/:id<br/>ATS breakdown, answers + recordings,<br/>AI evaluation, manual review"]
        INT["/interview/:token<br/>Verify email → Details → Guidelines → Interview"]
        DONE["/interview/:token/done"]
    end

    subgraph API["Flask API (app/routes)"]
        AUTH["/api/auth/login"]
        JOBS["/api/admin/jobs<br/>POST /api/admin/jd (paste text)<br/>POST /api/admin/jd/upload (PDF)<br/>GET /api/admin/jd/role/pdf<br/>DELETE /api/admin/job/role"]
        CANDAPI["/api/admin/candidate/id<br/>GET · DELETE<br/>POST /review · /retake<br/>POST /shortlist · /reevaluate"]
        INTAPI["/api/interview/token<br/>GET /state<br/>POST /verify/request · /verify/confirm<br/>POST /details · /guidelines<br/>POST /tab-warning · /answer"]
    end

    subgraph SVC["Services (app/services)"]
        AUTHS["auth_service<br/>users, roles, sessions"]
        JDS["jd_service + jd_parser<br/>raw JD → structured job + PDF"]
        CVP["cv_parser + resume_parser<br/>PDF → text"]
        ATS["ats_reviewer<br/>LLM score vs JD<br/>temp 0, cached by content hash"]
        QGEN["question_generator<br/>1 spoken intro + 20 MCQs<br/>10 JD-based + 10 resume-based<br/>(4 anchored to resume projects)"]
        ISVC["interview_service<br/>tokens, email OTP, answers,<br/>tab warnings (3 = abort)"]
        ESVC["evaluation_service<br/>MCQ deterministic + spoken LLM<br/>blend 0.4 objective / 0.6 spoken"]
        MAIL["email_service<br/>SMTP interview invite"]
    end

    subgraph EXT["External services"]
        NIM["NVIDIA NIM LLM<br/>nemotron-lightning-30b<br/>host.docker.internal:8100/v1"]
