@import "tailwindcss";

@theme {
  --font-sans: "Geist", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

/* Vercel/Geist-inspired token layer: achromatic, shadow-as-border, no animation. */
:root {
  --ink: #171717;
  --gray-600: #4d4d4d;
  --gray-500: #666666;
  --gray-400: #808080;
  --gray-100: #ebebeb;
  --gray-50: #fafafa;
  --link: #0072f5;
  --focus: hsla(212, 100%, 48%, 1);
  --ring: rgba(0, 0, 0, 0.08) 0px 0px 0px 1px;
}

html {
  font-feature-settings: "liga";
}

body {
  background: #ffffff;
  color: var(--ink);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

@layer components {
  /* Card: shadow stack instead of borders (ring + soft lift + inner highlight) */
  .card {
    background: #ffffff;
    border-radius: 8px;
    box-shadow:
      rgba(0, 0, 0, 0.08) 0px 0px 0px 1px,
      rgba(0, 0, 0, 0.04) 0px 2px 2px,
      #fafafa 0px 0px 0px 1px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.43;
    padding: 7px 14px;
    border-radius: 6px;
    border: none;
    background: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .btn:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .btn-primary {
    background: var(--ink);
    color: #ffffff;
  }
  .btn-primary:hover:not(:disabled) {
    background: #3b3b3b;
  }
  .btn-secondary {
    background: #ffffff;
    color: var(--ink);
    box-shadow: var(--ring);
  }
  .btn-secondary:hover:not(:disabled) {
    background: var(--gray-50);
  }

  .input,
  .select {
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 7px 10px;
    border-radius: 6px;
    border: none;
    box-shadow: var(--ring);
    background: #ffffff;
    color: var(--ink);
  }
  .input:focus,
  .select:focus,
  .btn:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  /* Status pills: tinted, functional color only */
  .pill {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
  }
  .pill-gray { background: #f5f5f5; color: #525252; }
  .pill-blue { background: #ebf5ff; color: #0068d6; }
  .pill-green { background: #e7f6ec; color: #177245; }
  .pill-red { background: #fdedec; color: #c1362c; }

  /* Technical micro label (Geist Mono uppercase) */
  .label-micro {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--gray-500);
  }

  /* Data table */
  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .table th {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--gray-500);
    text-align: left;
    padding: 10px 16px;
    border-bottom: 1px solid var(--gray-100);
  }
  .table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--gray-100);
    vertical-align: middle;
  }
  .table tbody tr:hover {
    background: var(--gray-50);
  }
  .table tbody tr:last-child td {
    border-bottom: none;
  }

  .link {
    color: var(--link);
    text-decoration: none;
  }
  .link:hover {
    text-decoration: underline;
  }

  .app-header {
    position: sticky;
    top: 0;
    background: #ffffff;
    box-shadow: var(--ring);
    z-index: 10;
  }

  .logo-mark {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: var(--ink);
  }

  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* App frame: fixed sidebar + fluid main column */
  .sidebar {
    width: 232px;
    flex-shrink: 0;
    box-shadow: var(--ring);
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #ffffff;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--gray-600);
    text-decoration: none;
  }
  .nav-item:hover {
    background: var(--gray-50);
  }
  .nav-item.active {
    background: #f5f5f5;
    color: var(--ink);
  }

  .stat-num {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.1;
  }

  /* Thin score meter */
  .meter {
    height: 3px;
    border-radius: 2px;
    background: var(--gray-100);
    width: 56px;
    overflow: hidden;
  }
  .meter > span {
    display: block;
    height: 100%;
    border-radius: 2px;
  }

  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f5f5f5;
    color: var(--gray-600);
    font-size: 11px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Filter tabs */
  .tab {
    padding: 5px 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--gray-500);
    border-radius: 6px;
    cursor: pointer;
    border: none;
    background: none;
  }
  .tab:hover {
    background: var(--gray-50);
  }
  .tab.active {
    background: #f5f5f5;
    color: var(--ink);
  }

  /* Interview progress segments */
  .seg {
    height: 3px;
    flex: 1;
    border-radius: 2px;
    background: var(--gray-100);
  }
  .seg.done {
    background: var(--ink);
  }
}
